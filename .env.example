# Copy to .env.local (local) or set in your hosting dashboard. Never commit real values.

# ---- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Meta Pixel + Conversions API ------------------------------------------
# Pixel ID is public (ships to the browser). The CAPI token is a server-only secret.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Test event code from Events Manager -> Test events. Remove in production.
META_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v23.0

# ---- Google Tag Manager (optional) -----------------------------------------
# Do not add Meta Pixel tags inside GTM as well, or events will double count.
NEXT_PUBLIC_GTM_ID=

# ---- Payments: Razorpay (PHASE 2) ------------------------------------------
# Leave PAYMENTS_ENABLED=false until the Phase 2 integration is built and tested.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Upstash Redis (registrations + webhook idempotency) --------------------
# Upstash console -> your database -> REST API. Server-only secrets.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (The Vercel Marketplace "Upstash for Redis" integration injects KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.)

# ---- Post-payment ------------------------------------------------------------
# Official workshop WhatsApp group invite link. Server-only: shown only after verified payment.
WHATSAPP_GROUP_URL=

# Copy to .env.local (local) or set in your hosting dashboard. Never commit real values.

# ---- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Meta Pixel + Conversions API ------------------------------------------
# Pixel ID is public (ships to the browser). The CAPI token is a server-only secret.
# Optional: defaults to 1571576558333946 (lib/meta.ts).
NEXT_PUBLIC_META_PIXEL_ID=
# Needed for server-side events (Lead/Purchase with hashed contact details, survives ad-blockers):
# Events Manager -> your Pixel -> Settings -> Conversions API -> Generate access token.
META_CAPI_ACCESS_TOKEN=
# Test event code from Events Manager -> Test events. Remove in production.
META_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v23.0

# ---- Google Tag Manager (optional) -----------------------------------------
# Do not add Meta Pixel tags inside GTM as well, or events will double count.
NEXT_PUBLIC_GTM_ID=

# ---- Payments: Razorpay (no database: Razorpay stores orders, payments and customer notes) ----
# Set PAYMENTS_ENABLED=true only when the keys below are set (use rzp_test_ keys to test first).
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ---- Post-payment ------------------------------------------------------------
# Official workshop WhatsApp group invite link. Server-only: shown only after verified payment.
WHATSAPP_GROUP_URL=
